# Copy to .env. Never commit secrets. Node loads this file at startup.
PORT=3000
PUBLIC_URL=http://localhost:3000
# Demo accounts share data. Leave false for a private pilot.
ALLOW_DEMO=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# The callback registered in Google Cloud must be:
# http://localhost:3000/api/auth/google/callback

# Optional generative Roomie. With no key, local catalog commands work.
# ROOMIE_API_KEY=
# ROOMIE_API_URL=https://api.openai.com/v1/chat/completions
# ROOMIE_MODEL=gpt-4.1-mini

# Optional browser call relay. Use your own TURN service.
# TURN_URL=turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=
# DB_PATH=/workspace/roomie/.data/roomverse.sqlite
# MEDIA_DIR=/workspace/roomie/.data/media
# Render automatically supplies RENDER_EXTERNAL_URL when PUBLIC_URL is unset.
