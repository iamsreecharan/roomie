{
  "name": "roomverse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:load": "node tests/load.js",
    "test:ui": "node tests/ui.e2e.js",
    "test:media": "node tests/media.e2e.js",
    "test:hall-media": "node tests/hall-media.e2e.js",
    "format": "prettier --write src server tests vite.config.js index.html",
    "admin": "node server/manage.js"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=24"
  }
}
